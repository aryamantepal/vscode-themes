    "list.inactiveSelectionBackground": "#ff1a4a12",
    "list.highlightForeground": "#ff1a4a",
    "tree.indentGuidesStroke": "#2a1040",
    "gitDecoration.modifiedResourceForeground": "#00e5ff",
    "gitDecoration.deletedResourceForeground": "#ff1a4a",
    "gitDecoration.addedResourceForeground": "#00ff88",
    "gitDecoration.untrackedResourceForeground": "#8040ff",
    "notifications.background": "#0d0018",
    "notifications.border": "#ff1a4a",
    "notificationToast.border": "#ff1a4a",
    "notificationsErrorIcon.foreground": "#ff1a4a",
    "notificationsInfoIcon.foreground": "#00e5ff",
    "notificationsWarningIcon.foreground": "#ff8c00",
    "menu.background": "#0d0018",
    "menu.foreground": "#e0d7f0",
    "menu.selectionBackground": "#ff1a4a20",
    "menu.selectionForeground": "#ff1a4a",
    "menu.border": "#2a1040",
    "menubar.selectionBackground": "#ff1a4a15",
    "menubar.selectionForeground": "#ff1a4a"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#3d2855",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#ff1a4a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": {
        "foreground": "#ff8c00"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#8040ff"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "support.variable"],
      "settings": {
        "foreground": "#e0d7f0"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#c4a8ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constants & Numbers",
      "scope": ["constant.numeric", "constant.language", "support.constant"],
      "settings": {
        "foreground": "#ff8c00"
      }
    },
    {
      "name": "Types & Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "entity.name.tag"],
      "settings": {
        "foreground": "#ff0090"
      }
    },
    {
      "name": "Interfaces & Generics",
      "scope": ["entity.name.interface", "support.type"],
      "settings": {
        "foreground": "#e040fb"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#ff1a4a"
      }
    },
    {
      "name": "Decorators / Attributes",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": {
        "foreground": "#ff8c00"
      }
    },
    {
      "name": "Object Properties",
      "scope": ["variable.other.property", "support.type.property-name"],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#4a3060"
      }
    },
    {
      "name": "HTML Tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#ff1a4a"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#8040ff"
      }
    },
    {
      "name": "CSS Properties",
      "scope": ["support.type.property-name.css"],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "CSS Values",
      "scope": ["support.constant.property-value.css"],
      "settings": {
        "foreground": "#ff8c00"
      }
    },
    {
      "name": "Imports / Namespaces",
      "scope": ["keyword.other.import", "entity.name.namespace"],
      "settings": {
        "foreground": "#ff1a4a"
      }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#ff0090"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#ff1a4a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#ff8c00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#8040ff"
      }
    }
  ]
}
