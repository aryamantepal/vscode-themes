    "editorCursor.foreground": "#ff1a4a",
    "editorIndentGuide.background": "#150025",
    "editorIndentGuide.activeBackground": "#2a1040",
    "editorBracketMatch.background": "#ff1a4a22",
    "editorBracketMatch.border": "#ff1a4a",
    "editorWidget.background": "#0d0018",
    "editorWidget.border": "#ff1a4a",
    "editorSuggestWidget.background": "#0d0018",
    "editorSuggestWidget.border": "#2a1040",
    "editorSuggestWidget.selectedBackground": "#ff1a4a20",
    "editorSuggestWidget.highlightForeground": "#ff1a4a",
    "peekView.border": "#ff1a4a",
    "peekViewEditor.background": "#08000f",
    "peekViewResult.background": "#0d0018",
    "peekViewTitle.background": "#0d0018",
    "badge.background": "#ff1a4a",
    "badge.foreground": "#ffffff",
    "list.activeSelectionBackground": "#ff1a4a20",
    "list.activeSelectionForeground": "#ff1a4a",
