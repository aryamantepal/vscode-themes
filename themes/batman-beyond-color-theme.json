    "tab.activeBorderTop": "#ff1a4a",
    "tab.border": "#150025",
    "editorGroupHeader.tabsBackground": "#05000a",
    "panel.background": "#05000a",
    "panel.border": "#1a0030",
    "panelTitle.activeForeground": "#ff1a4a",
    "panelTitle.inactiveForeground": "#5a3d75",
    "panelTitle.activeBorder": "#ff1a4a",
    "terminal.background": "#08000f",
    "terminal.foreground": "#e0d7f0",
    "terminal.ansiRed": "#ff1a4a",
    "terminal.ansiCyan": "#00e5ff",
    "terminal.ansiBlue": "#8040ff",
    "terminal.ansiMagenta": "#ff0090",
    "terminal.ansiYellow": "#ff8c00",
    "terminal.ansiGreen": "#00ff88",
    "terminal.ansiBrightRed": "#ff4d70",
    "terminal.ansiBrightCyan": "#40eeff",
