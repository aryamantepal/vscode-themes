    "editor.lineHighlightBackground": "#ff1a4a08",
    "editor.selectionBackground": "#ff1a4a25",
    "editor.selectionHighlightBackground": "#00e5ff15",
    "editor.findMatchBackground": "#ff1a4a40",
    "editor.findMatchHighlightBackground": "#ff1a4a20",
    "titleBar.activeBackground": "#05000a",
    "titleBar.activeForeground": "#ff1a4a",
    "titleBar.inactiveBackground": "#05000a",
    "titleBar.inactiveForeground": "#3d2855",
    "tab.activeBackground": "#0d0018",
    "tab.activeForeground": "#ff1a4a",
    "tab.inactiveBackground": "#05000a",
